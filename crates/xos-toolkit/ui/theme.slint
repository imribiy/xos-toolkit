export global Theme {
    in-out property <bool> dark: true;
    in-out property <string> font: "Segoe UI Variable Text";
    out property <string> mono-font: "Cascadia Mono";

    out property <color> bg-dark: dark ? #181818 : #FFFFFF;
    out property <color> bg-medium: dark ? #202020 : #F7F7F7;
    out property <color> bg-card: dark ? #202020 : #FFFFFF;
    out property <color> bg-card-hover: dark ? #262626 : #F7F7F7;
    out property <color> bg-elevated: dark ? #2A2A2A : #F0F0F0;
    out property <color> sidebar-active: dark ? #313131 : #E8E8E8;
    out property <color> hover-overlay: dark ? #292929 : #EFEFEF;
    out property <color> border-subtle: dark ? #303030 : #E1E1E1;
    out property <color> border-strong: dark ? #3A3A3A : #D0D0D0;
    out property <color> grid-line: dark ? #272727 : #ECECEC;
    out property <color> accent-blue: dark ? #8AB4E8 : #3976A8;
    out property <color> on-accent: dark ? #181818 : #FFFFFF;
    out property <color> accent-green: dark ? #65C89B : #247A59;
    out property <color> accent-red: dark ? #F06A78 : #B7374C;
    out property <color> accent-orange: dark ? #E6A15C : #8B541F;
    out property <color> accent-purple: dark ? #B99AEF : #6C4AA0;
    out property <color> text-primary: dark ? #DFDFDF : #202020;
    out property <color> text-secondary: dark ? #B9B9B9 : #5F5F5F;
    out property <color> text-muted: dark ? #868686 : #8A8A8A;
    out property <color> action-surface: dark ? #2A2A2A : #F0F0F0;
    out property <color> action-border: dark ? #454545 : #D0D0D0;
    out property <color> success-surface: dark ? #1B2B25 : #E8F3EE;
    out property <color> success-border: dark ? #355C4D : #A4C9B9;
    out property <color> danger-surface: dark ? #321C20 : #FAECEF;
    out property <color> danger-border: dark ? #704047 : #D9ABB4;
    out property <color> warning-surface: dark ? #30251B : #F7F0E7;
    out property <color> warning-border: dark ? #6B5136 : #D5BB9A;
    out property <color> neutral-surface: dark ? #242A2E : #EFF2F4;
    out property <color> neutral-border: dark ? #465159 : #C5CED3;
    out property <color> overlay: dark ? #181818D9 : #F2F4F7D9;
    out property <color> overlay-text: dark ? #FFFFFF : #202020;
    out property <color> card-border: dark ? #303030 : #E1E1E1;
    out property <color> card-border-hover: dark ? #444444 : #C9C9C9;

    public pure function tone-fg(t: int) -> color {
        if (t == 1) { return accent-green; }
        if (t == 2) { return accent-red; }
        if (t == 3) { return accent-orange; }
        if (t == 4) { return accent-blue; }
        if (t == 5) { return text-muted; }
        return text-secondary;
    }
    public pure function tone-surface(t: int) -> color {
        if (t == 1) { return success-surface; }
        if (t == 2) { return danger-surface; }
        if (t == 3) { return warning-surface; }
        return neutral-surface;
    }
    public pure function tone-border(t: int) -> color {
        if (t == 1) { return success-border; }
        if (t == 2) { return danger-border; }
        if (t == 3) { return warning-border; }
        return neutral-border;
    }
    public pure function btn-fg(s: int) -> color {
        if (s == 1) { return accent-green; }
        if (s == 2) { return accent-red; }
        if (s == 3) { return accent-orange; }
        return accent-blue;
    }
    public pure function btn-bg(s: int) -> color {
        if (s == 1) { return success-surface; }
        if (s == 2) { return danger-surface; }
        if (s == 3) { return warning-surface; }
        if (s == 4) { return transparent; }
        return action-surface;
    }
    public pure function btn-border(s: int) -> color {
        if (s == 1) { return success-border; }
        if (s == 2) { return danger-border; }
        if (s == 3) { return warning-border; }
        if (s == 4) { return transparent; }
        return action-border;
    }
    public pure function row-tone(t: int) -> color {
        if (t == 0) { return text-primary; }
        return tone-fg(t);
    }
}
